@model MisSolicitudesViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Mis Solicitudes de Crédito</h1>
            <a asp-action="Create" class="btn btn-primary">+ Nueva Solicitud</a>
        </div>
    </div>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-action="MisSolicitudes" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="MontoMin" class="form-label"></label>
                <input asp-for="MontoMin" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MontoMin" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MontoMax" class="form-label"></label>
                <input asp-for="MontoMax" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MontoMax" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="FechaFin" class="form-label"></label>
                <input asp-for="FechaFin" class="form-control" type="date" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
                <a asp-action="MisSolicitudes" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
    </div>
</form>

@if (Model.Solicitudes.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle shadow-sm">
            <thead class="table-light">
                <tr>
                    <th scope="col">N.º</th>
                    <th scope="col">Monto Solicitado</th>
                    <th scope="col">Fecha de Solicitud</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in Model.Solicitudes)
                {
                    <tr>
                        <td>@solicitud.Id</td>
                        <td>@solicitud.MontoSolicitado.ToString("C")</td>
                        <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(solicitud.Estado == EstadoSolicitud.Pendiente
                                ? "bg-warning text-dark"
                                : solicitud.Estado == EstadoSolicitud.Aprobado
                                    ? "bg-success"
                                    : "bg-danger")">
                                @solicitud.Estado
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-primary">Ver Detalle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted">Se encontraron @Model.Solicitudes.Count solicitud(es).</p>
}
else if (ViewData.ModelState.IsValid)
{
    <div class="alert alert-info text-center py-5">
        No se encontraron solicitudes con los criterios indicados.
    </div>
}

@if (Model.ClienteId.HasValue && !string.IsNullOrWhiteSpace(Config["PieSocket:ClusterId"]) && !string.IsNullOrWhiteSpace(Config["PieSocket:ApiKey"]))
{
    var clusterId = Config["PieSocket:ClusterId"];
    var apiKey = Config["PieSocket:ApiKey"];

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
        <div id="notificacionToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Solicitud de crédito</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
            <div class="toast-body" id="notificacionToastMensaje"></div>
        </div>
    </div>

    <script>
        (function () {
            const clusterId = '@clusterId';
            const apiKey = '@apiKey';
            const clienteId = '@Model.ClienteId';

            const ws = new WebSocket('wss://' + clusterId + '.piesocket.com/v3/canal-cliente-' + clienteId + '?api_key=' + apiKey);

            ws.onopen = function () {
                console.log('Conectado al canal canal-cliente-' + clienteId);
            };

            ws.onmessage = function (event) {
                let mensaje = event.data;

                try {
                    const parsed = JSON.parse(event.data);
                    if (parsed && parsed.data) {
                        mensaje = typeof parsed.data === 'string' ? parsed.data : JSON.stringify(parsed.data);
                    } else if (parsed && parsed.message) {
                        mensaje = parsed.message;
                    }
                } catch (e) { }

                const toastEl = document.getElementById('notificacionToast');
                const toastBody = document.getElementById('notificacionToastMensaje');

                toastBody.textContent = mensaje;

                const toast = window.bootstrap
                    ? new bootstrap.Toast(toastEl, { autohide: false })
                    : null;

                if (toast) {
                    toastEl.addEventListener('hidden.bs.toast', function () {
                        location.reload();
                    });
                    toast.show();
                }
            };

            ws.onerror = function (error) {
                console.error('Error en el WebSocket de PieSocket:', error);
            };
        })();
    </script>
}