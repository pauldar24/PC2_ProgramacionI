@model CrearSolicitudViewModel
@{
    ViewData["Title"] = "Nueva Solicitud";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Nueva Solicitud de Crédito</h1>
            <a asp-action="MisSolicitudes" class="btn btn-outline-secondary">← Volver</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                @if (Model.IngresosMensuales.HasValue)
                {
                    <div class="alert alert-secondary">
                        Ingresos mensuales declarados: <strong>@Model.IngresosMensuales.Value.ToString("C")</strong>.
                        <br />
                        Monto máximo solicitable (10 × ingresos): <strong>@Model.MontoMaximoPermitido?.ToString("C")</strong>.
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="MontoSolicitado" class="form-label"></label>
                        <input asp-for="MontoSolicitado" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Registrar Solicitud</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}